# Notion
NOTION_TOKEN=

# Pinecone: this index must be created with dimension 384
PINECONE_API_KEY=
PINECONE_INDEX_NAME=abhyasam-fastembed-index
PINECONE_NAMESPACE=notion-knowledge

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=abhyasam-1234

# Required by the existing chatbot
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REQUESTS_PER_MINUTE=20
GROQ_TOKENS_PER_MINUTE=8000
MCQ_MAX_OUTPUT_TOKENS=2048
# Local development downloads the public model once; Docker bakes it at build time.
FASTEMBED_LOCAL_FILES_ONLY=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
