# Notion API
NOTION_TOKEN=your_notion_integration_token

# Groq API (for LLM)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Groq API Rate Limits
# Free tier default: 30 RPM, 15000 TPM
# Adjust based on your plan: https://console.groq.com/settings/limits
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_MINUTE=15000

# HuggingFace (optional)
HUGGINGFACE_TOKEN=your_huggingface_token

# Pinecone Vector DB
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=abhyasam-fastembed-index
PINECONE_NAMESPACE=notion-knowledge

# Observability (optional)
OPIK_API_KEY=your_opik_key
LANGFUSE_SECRET_KEY=your_langfuse_secret
LANGFUSE_PUBLIC_KEY=your_langfuse_public
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Google Cloud (for state storage)
GOOGLE_CLOUD_PROJECT=your_project_id
GCS_BUCKET_NAME=your_bucket_name

# RAG Settings
NOTION_NAMESPACE=notion-knowledge
RAG_LOW_SCORE_THRESHOLD=0.15

# MCQ Generation Settings
# Max chunks to retrieve from vector DB (lower = fewer API calls)
MCQ_MAX_CHUNKS=80
# Number of chunks to randomly sample for processing (reduces API usage)
MCQ_SAMPLE_SIZE=25
# Minimum chunk length to filter junk content (chars)
MCQ_MIN_CHUNK_LENGTH=50
# Max tokens for MCQ generation output
MCQ_MAX_OUTPUT_TOKENS=2048
